  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "onFailure": "block",
            "timeout": 20,
            "command": "N=$(ls \"$CLAUDE_PROJECT_DIR\"/.gradle/nodejs/*/node.exe 2>/dev/null | head -1); \"${N:-node}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/controle-chemins.js\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "fhir-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/davidouagne/fhir-skills.git"
      },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "fhir-skills@fhir-skills": true,
    "mattpocock-skills@mattpocock": true
